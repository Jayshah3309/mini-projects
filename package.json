{
  "name": "mini-projects-learning",
  "version": "1.1.0",
  "private": true,
  "description": "Browser demos and native C learning examples",
  "scripts": {
    "test": "node --test tests/unit.test.cjs",
    "check": "python tools/check_repository.py",
    "test:browser": "playwright test",
    "serve": "python -m http.server 8000",
    "format": "prettier --write \"assets/management*\" \"assets/learning*\" assets/accessibility.css tests playwright.config.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.9"
  }
}
